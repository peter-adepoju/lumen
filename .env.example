# Google sign-in (see SETUP.md). Without these, Lumen still runs and saves to the device only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the sign-in cookie. Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Optional: the public address, e.g. https://lumen-xyz.vercel.app (defaults to the request's origin).
APP_URL=
